{
  "name": "nudge-mode",
  "version": "0.4.1",
  "description": "Design mode for herdr. Select components on a local dev server, comment on them, and send them to the herdr agent working on that project.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Achno2k/design-mode.git"
  },
  "bugs": {
    "url": "https://github.com/Achno2k/design-mode/issues"
  },
  "homepage": "https://github.com/Achno2k/design-mode#readme",
  "keywords": [
    "nudge",
    "herdr",
    "chrome-extension",
    "design-mode",
    "dev-tools",
    "code-review",
    "ai-agent"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "nudge-mode": "bin/nudge.mjs",
    "nudge": "bin/nudge.mjs"
  },
  "files": [
    "bin",
    "dist",
    "extension/dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:daemon && npm run build:extension",
    "build:daemon": "esbuild daemon/src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/daemon.js",
    "build:extension": "cd extension && npm run build",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
